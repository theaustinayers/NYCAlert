# Discord application/bot credentials (never commit real values)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands only in this guild during development
DISCORD_GUILD_ID=

# Broadcastify JWT credentials: KEY_ID is the API Key ID, ISSUER is your
# application ID (JWT iss), and SECRET is the API Key itself. Never commit these.
BROADCASTIFY_API_BASE_URL=https://api.bcfy.io
BROADCASTIFY_JWT_KEY_ID=
BROADCASTIFY_JWT_ISSUER=
BROADCASTIFY_JWT_SECRET=
# Authenticated static URL is used only by the server-side NYPD stream monitor.
BROADCASTIFY_NYPD_FEED_ID=47753
BROADCASTIFY_STATIC_USERNAME=
BROADCASTIFY_STATIC_PASSWORD=
BROADCASTIFY_NYPD_STREAM_ENABLED=false
BROADCASTIFY_NYPD_SEGMENT_SECONDS=90
BROADCASTIFY_AUDIO_ALLOWED_HOSTS=
BROADCASTIFY_AUDIO_MAX_BYTES=20971520
# FDNY Calls playlist UUIDs supplied by the account owner.
BROADCASTIFY_FEED_MAP=[{"playlistUuid":"83064fd5-010e-11f1-bb32-0ef97433b5f9","borough":"Manhattan","agency":"FDNY"},{"playlistUuid":"acfe9884-010e-11f1-bb32-0ef97433b5f9","borough":"Bronx","agency":"FDNY"},{"playlistUuid":"9344f685-010f-11f1-bb32-0ef97433b5f9","borough":"Queens","agency":"FDNY"},{"playlistUuid":"72a9370f-010f-11f1-bb32-0ef97433b5f9","borough":"Brooklyn","agency":"FDNY"},{"playlistUuid":"b4b71363-010f-11f1-bb32-0ef97433b5f9","borough":"Staten Island","agency":"FDNY"}]
BROADCASTIFY_CALLS_ENABLED=false
BROADCASTIFY_LIVE_ENABLED=false
# Calls API polling interval. With five playlists, 60000ms is about 1 API request/minute total
# and checks each playlist about every 5 minutes. Lower values increase request volume/latency.
BROADCASTIFY_POLL_INTERVAL_MS=60000

# Local transcription uses whisper.cpp; the model path is installed by deploy/install-ubuntu.sh.
# OpenAI is still used for AI call triage/summaries and can be omitted only if those features are removed.
# Bootstrap administrator; use a unique password with at least 16 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SMTP is required to verify new audience accounts and deliver administrator invitations.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="NYC Alert <noreply@nycalert.ai>"
WHISPER_CPP_PATH=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-base.en.bin
WHISPER_THREADS=2
FFMPEG_PATH=/usr/bin/ffmpeg
TRIAGE_MODEL=gpt-4o-mini
# Minimum AI newsworthiness score (1 = more alerts; 5 = only the most significant).
NEWSWORTHINESS_THRESHOLD=4
# Minimum buff-interest score for subscriptions configured with audience=buff.
BUFF_INTEREST_THRESHOLD=4
# Minimum assignment-desk score for Discord subscriptions configured with audience=news.
NEWS_MEDIA_DESK_THRESHOLD=4
# Only set true if your Broadcastify agreement expressly permits redistributing MP3s to Discord.
BROADCASTIFY_AUDIO_REDISTRIBUTION_ALLOWED=false
# Optional automatic posts for newly published Public-qualified incidents. Uses X API user auth.
X_AUTO_POST_ENABLED=false
# Wait for correlated radio follow-ups before posting; bounded to 0-300 seconds (default 60).
X_POST_DELAY_SECONDS=60
# Set either an OAuth2 user-context token, or all four OAuth 1.0a user credentials; never both.
X_USER_ACCESS_TOKEN=
X_OAUTH_CONSUMER_KEY=
X_OAUTH_CONSUMER_SECRET=
X_OAUTH_ACCESS_TOKEN=
X_OAUTH_ACCESS_TOKEN_SECRET=
# Public HTTP dashboard; deploy behind HTTPS/reverse proxy and firewall as appropriate.
DASHBOARD_HOST=0.0.0.0
# Public canonical site base URL used in incident permalink/share URLs.
DASHBOARD_PUBLIC_URL=https://nycalert.ai
# Optional comma-separated HTTPS origins allowed to read /api/v1/incidents from another frontend.
DASHBOARD_READ_API_ORIGINS=
# Set true only when the app is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false
# Leave blank to use the port allocated by Pterodactyl (SERVER_PORT/PORT), or set a fixed port.
DASHBOARD_PORT=
# When enabled, FDNY call audio is downloaded and retained for playback on the public dashboard.
# This increases per-call media downloads; enable only if your Broadcastify terms permit it.
DASHBOARD_PUBLIC_AUDIO=false
# Transcripts can contain sensitive information. Keep false unless public display is approved.
DASHBOARD_PUBLIC_TRANSCRIPTS=false
MAP_GEOCODER_CONTACT=
# Transcript/triage audit log for offline analysis; stores transcript text, never audio files.
# Contains potentially sensitive radio content. Keep the data directory private and set an appropriate retention period.
AI_LEARNING_LOG_ENABLED=false
AI_LEARNING_LOG_RETENTION_DAYS=30
AI_LEARNING_LOG_MAX_EVENTS=20000
DATA_DIR=./data
LOG_LEVEL=info
